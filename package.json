{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx concurrently \"pnpm --filter @workspace/api-server run dev\" \"pnpm --filter @workspace/portfolio run dev\"",
    "build": "pnpm -r --if-present run build",
    "build:api": "cd artifacts/api-server && node build.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "api-server": "^1.0.5",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.12",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  }
}
